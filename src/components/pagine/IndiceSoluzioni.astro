---
/**
 * Corpo dell'indice delle tipologie di copertura, condiviso fra italiano
 * (/soluzioni) e inglese (/en/solutions).
 *
 * Una scheda diventa cliccabile solo se ha una pagina nella lingua corrente:
 * in inglese esiste la sola Tecnowing, e le altre restano schede complete in
 * se', esattamente come Coverplan in italiano. Vale anche per il campionario
 * dei rivestimenti, che in inglese non ha pagina: li' il blocco resta, ma
 * senza collegamento e senza invito a cliccare.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SolutionCard from '../../components/SolutionCard.astro';
import Picture from '../../components/Picture.astro';
import Icon from '../../components/Icon.astro';
import { rivestimenti } from '../../data/progetti';
import type { Soluzione } from '../../data/soluzioni';
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
  soluzioni: readonly Soluzione[];
  /** Percorso del campionario finiture, oppure null se non esiste in questa lingua. */
  hrefRivestimenti: string | null;
  t: Record<string, string>;
}

const { lang, soluzioni, hrefRivestimenti, t } = Astro.props;

const hrefHome = lang === 'en' ? '/en' : '/';
const hrefContatti = lang === 'en' ? '/en/contact' : '/contatti';

const TagFiniture = hrefRivestimenti ? 'a' : 'div';

/* Quattro campioni distanti fra loro nel campionario: danno l'idea della
   varieta' meglio di quattro consecutivi, che spesso si somigliano. */
const anteprima = [0, 18, 37, 56].map((i) => rivestimenti[i]).filter(Boolean);

/* Due griglie separate invece di una sola con celle a doppia larghezza:
   con sette schede in tre colonne, le due in evidenza lasciavano un buco
   proprio nella prima riga. */
const inEvidenza = soluzioni.filter((s) => s.inEvidenza);
const altre = soluzioni.filter((s) => !s.inEvidenza);
---

<BaseLayout
  title={t.seoTitolo}
  description={t.seoDescrizione}
  lang={lang}
>
  <PageHero
    eyebrow={t.eyebrow}
    title={t.titolo}
    lead={t.lead}
    crumbs={[{ label: t.home, href: hrefHome }, { label: t.briciola }]}
  />

  <section class="block sol">
    <div class="wrap">
      <ul class="sol-grid sol-grid--due stagger">
        {inEvidenza.map((s, i) => <SolutionCard soluzione={s} indice={i + 1} lang={lang} grande />)}
      </ul>

      <ul class="sol-grid sol-grid--tre stagger">
        {
          altre.map((s, i) => (
            <SolutionCard soluzione={s} indice={inEvidenza.length + i + 1} lang={lang} />
          ))
        }
      </ul>

      {/* Le finiture non sono coperture: stanno qui perché struttura e
          facciata si scelgono insieme, ma in un gruppo dichiarato a parte. */}
      <div class="fin-h reveal">
        <div>
          <p class="eyebrow">{t.finEyebrow}</p>
          <h2>{t.finTitolo}</h2>
        </div>
      </div>

      <TagFiniture {...(hrefRivestimenti ? { href: hrefRivestimenti } : {})} class="fin-card reveal">
        <div class="fin-txt">
          <span class="fin-tag">{t.finTag}</span>
          <h3>{t.finSottotitolo}</h3>
          <p>{t.finTesto}</p>
          {
            hrefRivestimenti && (
              <span class="more">
                {t.vediCampionario} <i><Icon nome="freccia-dx" dim={15} /></i>
              </span>
            )
          }
        </div>
        {/* Anteprima del campionario: quattro campioni veri valgono più di
            qualunque descrizione della superficie. */}
        <div class="fin-prov" aria-hidden="true">
          {
            anteprima.map((r) => (
              <Picture id={r.id} alt="" ratio="1/1" sizes="(max-width: 920px) 25vw, 12vw" />
            ))
          }
        </div>
      </TagFiniture>

      <p class="ph-note sol-note">
        {t.notaRevisione}
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-band on-dark">
    <div class="wrap">
      <div class="cta-inner reveal">
        <div>
          <p class="eyebrow">{t.ctaEyebrow}</p>
          <h2>{t.ctaTitolo}</h2>
          <p class="cta-p">{t.ctaTesto}</p>
        </div>
        <a href={hrefContatti} class="btn btn-red">
          {t.parliamoProgetto} <span class="arr"><Icon nome="freccia-dx" dim={17} /></span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .sol {
    background: var(--bg1);
  }

  .sol-grid {
    list-style: none;
    display: grid;
    gap: 22px;
  }

  /* Le due tipologie di punta su una riga a sé: dentro un'unica griglia a tre
     colonne lasciavano una cella vuota proprio in cima alla pagina. */
  .sol-grid--due {
    grid-template-columns: repeat(2, 1fr);
    margin-bottom: 22px;
  }

  .sol-grid--tre {
    grid-template-columns: repeat(3, 1fr);
  }

  .sol-note {
    margin-top: 40px;
  }

  /* --- Blocco finiture --------------------------------------------------- */
  .fin-h {
    margin-top: 72px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--bg2);
    margin-bottom: 24px;
  }
  .fin-h h2 {
    font-family: var(--brand);
    font-weight: 600;
    font-size: clamp(26px, 3.2vw, 38px);
    letter-spacing: -0.02em;
    margin-top: 14px;
    max-width: 24ch;
  }

  .fin-card {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: center;
    background: #fff;
    border: 1px solid var(--bg2);
    border-radius: var(--r-md);
    padding: 36px 38px;
    transition: box-shadow 0.4s var(--ease), border-color 0.4s,
      transform 0.4s var(--ease);
  }
  .fin-card:hover {
    box-shadow: var(--sh-card);
    border-color: #fff;
    transform: translateY(-4px);
  }

  .fin-tag {
    font-family: var(--brand);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--red);
  }
  .fin-txt h3 {
    font-family: var(--brand);
    font-weight: 600;
    font-size: clamp(20px, 2.2vw, 26px);
    letter-spacing: -0.01em;
    margin: 12px 0 12px;
    max-width: 22ch;
  }
  .fin-txt p {
    font-size: 14.5px;
    max-width: 52ch;
  }
  .fin-txt .more {
    margin-top: 20px;
  }

  .fin-prov {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }
  .fin-prov :global(.frame) {
    border-radius: var(--r-sm);
  }

  /* --- CTA condivisa ---------------------------------------------------- */
  .cta-band {
    background: var(--navy-deep);
    padding: 90px 0;
  }
  .cta-inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }
  .cta-inner h2 {
    font-family: var(--brand);
    font-weight: 600;
    font-size: clamp(30px, 4vw, 48px);
    margin: 16px 0;
    letter-spacing: -0.02em;
  }
  .cta-p {
    max-width: 46ch;
    color: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 1000px) {
    .sol-grid--tre {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 820px) {
    /* Testo sopra, campioni sotto: affiancati sotto questa soglia i campioni
       diventano troppo piccoli per dire qualcosa di una superficie. */
    .fin-card {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 28px 24px;
    }
  }

  @media (max-width: 700px) {
    .sol-grid--due,
    .sol-grid--tre {
      grid-template-columns: 1fr;
    }
    .fin-h {
      margin-top: 52px;
    }
    .cta-band {
      padding: 64px 0;
    }
  }
</style>
