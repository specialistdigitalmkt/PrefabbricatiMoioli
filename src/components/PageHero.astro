---
/**
 * Apertura delle pagine interne.
 * Fascia navy compatta: dà alla testata un fondo scuro su cui appoggiarsi e
 * tiene le interne visivamente subordinate alla home.
 */
import Breadcrumb from './Breadcrumb.astro';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  crumbs: { label: string; href?: string }[];
}

const { eyebrow, title, lead, crumbs } = Astro.props;
---

<section class="ph on-dark">
  <div class="ph-grid" aria-hidden="true"></div>
  <div class="wrap">
    <Breadcrumb items={crumbs} />
    <p class="eyebrow ph-eyebrow">{eyebrow}</p>
    <h1 class="page-title">{title}</h1>
    {lead && <p class="lead ph-lead">{lead}</p>}
  </div>
</section>

<style>
  .ph {
    background: var(--navy);
    padding: 150px 0 72px;
    position: relative;
    overflow: hidden;
  }

  .ph-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.04) 0 1px,
      transparent 1px calc(100% / 6)
    );
    mask-image: linear-gradient(180deg, transparent, #000 60%);
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 60%);
  }

  .wrap {
    position: relative;
    z-index: 2;
  }

  .ph-eyebrow {
    margin-top: 26px;
  }

  .ph-lead {
    color: rgba(255, 255, 255, 0.72);
  }

  @media (max-width: 600px) {
    .ph {
      padding: 116px 0 52px;
    }
  }
</style>
