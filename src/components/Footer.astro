---
/**
 * Piè di pagina.
 * Ospita il blocco documentazione: i file non sono ancora pubblicati,
 * quindi il blocco rimanda alla richiesta invece di elencare download
 * inesistenti.
 */
import Logo from './Logo.astro';
import { azienda, nav, download } from '../data/site';
import { navEn, downloadEn, ui, type Lang } from '../i18n';

interface Props {
  /** Lingua del piè di pagina. */
  lang?: Lang;
}
const { lang = 'it' } = Astro.props;

const t = ui[lang];
const voci = lang === 'en' ? navEn : nav;
const doc = lang === 'en' ? downloadEn : download;

/* La riga d'impresa e' l'unica frase del piè di pagina: in inglese e'
   scritta qui invece di comporsi dai dati, perche' l'ordine delle parole
   non regge la traduzione parola per parola. */
const rigaImpresa =
  lang === 'en'
    ? `${azienda.ragioneSociale}: precast reinforced concrete structures since ${azienda.fondazione}.`
    : `${azienda.ragioneSociale}: ${azienda.descrizione.toLowerCase()} dal ${azienda.fondazione}.`;

const { indirizzo } = azienda;
---

<footer class="on-dark">
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        {/* Nel piè di pagina il lockup è sempre completo: qui il payoff
            non compete con nessun altro testo. */}
        <Logo variant="light" payoff="sempre" height={40} />
        {/* Riga fattuale, non il payoff: quello vive solo nell'apertura
            della home, altrimenti sulla home comparirebbe due volte. */}
        <p>{rigaImpresa}</p>
        <address>
          {indirizzo.via}, {indirizzo.cap} {indirizzo.citta} ({indirizzo.provincia})<br />
          <a href={`tel:${azienda.telefonoHref}`}>{azienda.telefono}</a><br />
          <a href={`mailto:${azienda.email}`}>{azienda.email}</a>
        </address>
      </div>

      <div class="foot-col">
        <h2 class="foot-h">{t.footNaviga}</h2>
        <nav class="foot-nav" aria-label={t.navSecondaria}>
          {voci.map((v) => <a href={v.href}>{v.label}</a>)}
        </nav>
      </div>

      <div class="foot-col">
        <h2 class="foot-h">{doc.titolo}</h2>
        {/* Finché i file non ci sono, il blocco dice come averli invece di
            elencare download che non partono. L'elenco (`download.voci`) è
            pronto in site.ts per quando arriveranno. */}
        <p class="dl-note">{doc.nota}</p>
        <a class="dl-cta" href={lang === 'en' ? '/en/contact' : '/contatti'}>
          {t.footRichiediDoc}
        </a>
        {
          lang === 'it' && (
            <>
              <h2 class="foot-h foot-h-2">Lavora con noi</h2>
              <a class="dl-cta" href="/azienda/lavora-con-noi">Le posizioni aperte</a>
            </>
          )
        }
      </div>
    </div>

    <div class="foot-bot">
      <span>
        &copy; {new Date().getFullYear()} {azienda.ragioneSociale}, P.IVA {azienda.piva}
      </span>
      <a class="foot-legal" href="/privacy">{t.footLegale}</a>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--navy-ink);
    color: rgba(255, 255, 255, 0.6);
    padding: 64px 0 30px;
    font-size: 14px;
  }

  .foot-top {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr 1.1fr;
    gap: 48px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .foot-brand p {
    margin-top: 16px;
    max-width: 34ch;
    color: rgba(255, 255, 255, 0.5);
  }

  address {
    font-style: normal;
    margin-top: 18px;
    line-height: 1.9;
    color: rgba(255, 255, 255, 0.55);
  }

  /* Telefono e mail stanno ognuno sulla propria riga: sono bersagli a sé, non
     collegamenti dentro una frase, quindi l'eccezione «inline» della 2.5.8 non
     vale. Il riempimento verticale li porta da 18 a 26 px senza spostare nulla:
     l'interlinea a 1.9 lo spazio ce l'ha già. */
  address a {
    display: inline-block;
    padding-block: 4px;
    transition: color 0.2s;
  }
  address a:hover {
    color: #fff;
  }

  .foot-h {
    font-family: var(--brand);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--red-soft);
    margin-bottom: 18px;
  }

  .foot-nav {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-start;
  }
  .foot-nav a {
    transition: color 0.2s;
    /* Altezza minima del bersaglio (WCAG 2.5.8): senza padding queste voci
       restavano a 22px. */
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 2px 0;
  }
  .foot-nav a:hover {
    color: #fff;
  }

  .dl-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .dl-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .dl-fmt {
    font-family: var(--brand);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--red-soft);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 2px;
    padding: 2px 6px;
    flex: none;
  }

  .dl-label {
    color: rgba(255, 255, 255, 0.75);
  }

  .dl-cta {
    display: inline-block;
    margin-top: 10px;
    padding-block: 4px;
    color: #fff;
    text-decoration: underline;
    text-decoration-color: var(--red-soft);
    text-underline-offset: 4px;
    transition: color 0.2s;
  }
  .dl-cta:hover {
    color: var(--red-soft);
  }
  .foot-h-2 {
    margin-top: 32px;
  }
  a.foot-legal {
    transition: color 0.2s;
  }
  a.foot-legal:hover {
    color: #fff;
  }
  .dl-note {
    margin-top: 16px;
    font-size: 13px;
    /* 0.55 anziché 0.42: sotto questa soglia il testo scende a 4.06:1
       su --navy-ink, sotto il minimo AA. */
    color: rgba(255, 255, 255, 0.55);
  }

  .foot-bot {
    padding-top: 22px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 12.5px;
    /* idem: 0.4 dava 3.79:1 su --navy-ink */
    color: rgba(255, 255, 255, 0.55);
  }

  @media (max-width: 920px) {
    .foot-top {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
    .foot-brand {
      grid-column: 1 / -1;
    }
  }

  /* Al tocco le voci del piè di pagina salgono a 44 px: sono elenchi fitti
     di link uno sotto l'altro, il caso in cui col pollice si sbaglia riga. */
  @media (pointer: coarse) {
    .foot-nav {
      gap: 0;
    }
    .foot-nav a,
    address a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding-block: 0;
    }
  }

  @media (max-width: 600px) {
    footer {
      padding-top: 48px;
    }
    .foot-top {
      grid-template-columns: 1fr;
      gap: 34px;
    }
  }
</style>
