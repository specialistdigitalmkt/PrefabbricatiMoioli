---
/**
 * Icone.
 *
 * Sostituiscono i caratteri tipografici usati prima come frecce (→ ↑ ←).
 * Quei glifi dipendono dal font installato: su alcuni sistemi cambiano peso,
 * su altri vengono resi come emoji a colori. Un tracciato vettoriale ha lo
 * stesso spessore ovunque e segue il colore del testo.
 *
 * Tratto unico a 1.75 per tutto il sito: lo spessore misto è la cosa che
 * più fa sembrare improvvisato un insieme di icone.
 */
interface Props {
  nome:
    | 'freccia-dx'
    | 'freccia-sx'
    | 'freccia-giu'
    | 'freccia-su'
    | 'chevron-giu'
    | 'chiudi'
    | 'menu'
    | 'telefono'
    | 'email'
    | 'allegato';
  /** Dimensione in px. */
  dim?: number;
  class?: string;
}

const { nome, dim = 18, class: className = '' } = Astro.props;

const tracciati: Record<Props['nome'], string> = {
  'freccia-dx': 'M4 12h15m-6-6 6 6-6 6',
  'freccia-sx': 'M20 12H5m6-6-6 6 6 6',
  'freccia-giu': 'M12 4v15m-6-6 6 6 6-6',
  'freccia-su': 'M12 20V5m-6 6 6-6 6 6',
  'chevron-giu': 'M6 9l6 6 6-6',
  chiudi: 'M6 6l12 12M18 6L6 18',
  menu: 'M3 6h18M3 12h18M3 18h18',
  telefono:
    'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2',
  email: 'M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm-1 2 9 6 9-6',
  allegato: 'M20 11.5 12.4 19a5 5 0 0 1-7.1-7.1L13 4.3a3.3 3.3 0 0 1 4.7 4.7l-7.6 7.6a1.7 1.7 0 0 1-2.4-2.4l7-7',
};
---

<svg
  class={`icon ${className}`}
  width={dim}
  height={dim}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={tracciati[nome]} />
</svg>

<style>
  .icon {
    display: block;
    flex: none;
  }
</style>
