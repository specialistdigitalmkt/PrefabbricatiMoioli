---
/**
 * /progetti — le realizzazioni fotografate, versione italiana.
 * Markup e stili nel componente condiviso con /en/projects.
 */
import IndiceProgetti from '../../components/pagine/IndiceProgetti.astro';
import { realizzazioni, paginaProgetti, etichetta } from '../../data/progetti';

const ui = {
  seoTitolo: 'Realizzazioni — Prefabbricati Moioli',
  seoDescrizione:
    'Le strutture prefabbricate realizzate da Moioli: capannoni industriali, poli logistici e sedi direzionali nel Nord Italia. Oltre 700.000 mq costruiti.',
  home: 'Home',
  briciola: 'Realizzazioni',
  conNome: 'Con denominazione',
  daNominare: 'Nome da assegnare',
  daNominareNota:
    'Realizzazioni reali, fotografate. L’archivio non riporta la denominazione: quando arriva, sostituisce il segnaposto.',
  fotografie: (n: number) => `${n} fotografie`,
  nomeDaAssegnare: 'NOME — da assegnare',
  schedaAlt: (nome: string) => `${nome} — struttura prefabbricata realizzata da Moioli`,
  schedaAltAnonima: 'Struttura prefabbricata realizzata da Prefabbricati Moioli',
  ctaEyebrow: 'Il prossimo',
  ctaTitolo: 'Il tuo stabilimento può essere il prossimo.',
  ctaTesto: 'Dalla progettazione strutturale alla consegna, con un solo interlocutore.',
  parliamoProgetto: 'Parliamo del tuo progetto',
};
---

<IndiceProgetti
  lang="it"
  realizzazioni={realizzazioni}
  intestazione={paginaProgetti}
  etichetta={etichetta}
  t={ui}
/>
