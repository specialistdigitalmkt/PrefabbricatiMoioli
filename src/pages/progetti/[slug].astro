---
/**
 * /progetti/[slug] — scheda di una realizzazione.
 *
 * Una pagina per ciascuna delle 25 realizzazioni fotografate.
 * Le fotografie sono reali; i dati di commessa non sono stati forniti e
 * restano segnaposto dichiarati, uno per riga, così in presentazione si vede
 * esattamente cosa manca.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Picture from '../../components/Picture.astro';
import Icon from '../../components/Icon.astro';
import { realizzazioni, schedaDettaglio, etichetta } from '../../data/progetti';
import images from '../../data/images.json';

export function getStaticPaths() {
  return realizzazioni.map((r) => ({ params: { slug: r.slug }, props: { r } }));
}

const { r } = Astro.props;
const nome = etichetta(r);

/* Le larghezze si leggono dal manifesto, non si scrivono a mano: le
   sorgenti hanno dimensioni diverse fra loro e dichiarare un taglio che non
   esiste manda l'immagine in errore. */
const cover = (images as Record<string, { widths: number[] }>)[r.cover];
const coverSrcset = cover.widths.map((w) => `/img/${r.cover}-${w}.webp ${w}w`).join(', ');
const coverSrc = `/img/${r.cover}-${cover.widths.at(-1)}.webp`;

/* Navigazione fra schede: chi guarda le realizzazioni le sfoglia, non torna
   ogni volta all'indice. */
const i = realizzazioni.findIndex((x) => x.slug === r.slug);
const prec = realizzazioni[i - 1] ?? realizzazioni[realizzazioni.length - 1];
const succ = realizzazioni[i + 1] ?? realizzazioni[0];
---

<BaseLayout
  title={`${nome} — Realizzazioni | Prefabbricati Moioli`}
  description={`${nome}: struttura prefabbricata in cemento armato realizzata da Prefabbricati Moioli, Bagnatica (BG).`}
  preloadImage={r.cover}
>
  <!-- ==================== APERTURA ==================== -->
  <section class="pd-hero on-dark">
    <div class="pd-hero-img">
      <img
        src={coverSrc}
        srcset={coverSrcset}
        sizes="100vw"
        alt={`${nome} — vista d'insieme`}
        fetchpriority="high"
        decoding="sync"
      />
    </div>
    <div class="pd-hero-grad" aria-hidden="true"></div>

    <div class="wrap pd-hero-body">
      <Breadcrumb
        items={[
          { label: 'Home', href: '/' },
          { label: 'Realizzazioni', href: '/progetti' },
          { label: nome },
        ]}
      />

      {r.numerata && <p class="pd-flag">Denominazione da assegnare</p>}
      <p class="eyebrow pd-eyebrow">Realizzazione</p>
      <h1>{nome}</h1>
      <p class="pd-conta">{r.totaleFoto} fotografie d’archivio</p>
    </div>
  </section>

  <!-- ==================== DATI ==================== -->
  <section class="block pd-dati">
    <div class="wrap">
      <div class="dati-grid">
        <div class="reveal">
          <h2 class="dati-t">{schedaDettaglio.datiTitolo}</h2>
          <dl class="dati-l">
            {
              schedaDettaglio.dati.map((d) => (
                <div>
                  <dt>{d.label}</dt>
                  <dd><span class="spec">{d.spec}</span></dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="reveal dati-nota">
          <p class="ph-note">{schedaDettaglio.nota}</p>
          <a href="/contatti" class="btn btn-ghost dati-btn">
            Chiedi informazioni su questa realizzazione
            <span class="arr"><Icon nome="freccia-dx" dim={17} /></span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== GALLERIA ==================== -->
  {
    r.galleria.length > 0 && (
      <section class="block pd-gal on-dark">
        <div class="wrap">
          <div class="sec-head reveal">
            <p class="eyebrow">Immagini</p>
            <h2>Come si presenta.</h2>
          </div>

          <div class="gal-grid stagger">
            {r.galleria.map((g, n) => (
              <figure class:list={['gal-item', { wide: g.ratio >= 1.6 }]}>
                <Picture
                  id={g.id}
                  alt={`${nome} — fotografia ${n + 1}`}
                  ratio={g.ratio >= 1.6 ? '16/9' : g.ratio >= 1.1 ? '3/2' : '3/4'}
                  sizes="(max-width: 700px) 100vw, 50vw"
                />
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ==================== SFOGLIA ==================== -->
  <section class="block pd-nav">
    <div class="wrap">
      <div class="nav-grid">
        <a href={`/progetti/${prec.slug}`} class="nav-l">
          <span class="nav-lab"><span class="arr-l"><Icon nome="freccia-sx" dim={15} /></span> Precedente</span>
          <span class="nav-n">{etichetta(prec)}</span>
        </a>

        <a href="/progetti" class="nav-c">Tutte le realizzazioni</a>

        <a href={`/progetti/${succ.slug}`} class="nav-r">
          <span class="nav-lab">Successiva <span class="arr"><Icon nome="freccia-dx" dim={15} /></span></span>
          <span class="nav-n">{etichetta(succ)}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== CTA ==================== -->
  <section class="cta-band on-dark">
    <div class="wrap">
      <div class="cta-inner reveal">
        <div>
          <p class="eyebrow">Contatti</p>
          <h2>Un progetto simile in programma?</h2>
          <p class="cta-p">Raccontaci cosa devi costruire: partiamo dai vincoli reali.</p>
        </div>
        <a href="/contatti" class="btn btn-red">
          Richiedi un preventivo <span class="arr"><Icon nome="freccia-dx" dim={17} /></span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ==================== APERTURA ==================== */
  .pd-hero {
    position: relative;
    min-height: 78svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--navy);
    color: #fff;
  }
  .pd-hero-img {
    position: absolute;
    inset: 0;
  }
  .pd-hero-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 50%;
  }
  .pd-hero-grad {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(22, 32, 58, 0.72) 0%,
      rgba(29, 42, 68, 0.34) 38%,
      rgba(22, 32, 58, 0.88) 84%,
      var(--navy) 100%
    );
  }
  .pd-hero-body {
    position: relative;
    z-index: 2;
    padding-top: 150px;
    padding-bottom: 56px;
    width: 100%;
  }

  .pd-flag {
    display: inline-block;
    margin-top: 24px;
    font-family: var(--mono);
    font-size: 12px;
    color: #fff;
    background: var(--red);
    padding: 6px 12px;
    border-radius: 2px;
  }

  .pd-eyebrow {
    margin-top: 20px;
    color: var(--red-soft);
  }

  .pd-hero h1 {
    font-family: var(--brand);
    font-weight: 600;
    font-size: clamp(36px, 5.6vw, 72px);
    letter-spacing: -0.025em;
    line-height: 1.02;
    margin: 14px 0 12px;
    color: #fff;
  }

  .pd-conta {
    font-family: var(--mono);
    font-size: 13px;
    color: rgba(255, 255, 255, 0.7);
    font-variant-numeric: tabular-nums;
  }

  /* ==================== DATI ==================== */
  .pd-dati {
    background: var(--white);
    padding-top: 88px;
    padding-bottom: 96px;
  }
  .dati-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 64px;
    align-items: start;
  }
  .dati-t {
    font-family: var(--brand);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 22px;
  }
  .dati-l > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    padding: 15px 0;
    border-bottom: 1px solid var(--bg2);
  }
  .dati-l > div:first-child {
    border-top: 1px solid var(--bg2);
  }
  .dati-l dt {
    font-size: 15px;
    color: var(--navy);
    font-weight: 500;
  }
  .dati-btn {
    margin-top: 24px;
  }

  /* ==================== GALLERIA ==================== */
  .pd-gal {
    background: var(--navy-ink);
  }
  .gal-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
  .gal-item {
    margin: 0;
    overflow: hidden;
    border-radius: var(--r-md);
  }
  .gal-item.wide {
    grid-column: span 2;
  }
  .gal-item :global(.frame img) {
    transition: transform 0.9s var(--ease);
  }
  .gal-item:hover :global(.frame img) {
    transform: scale(1.04);
  }

  /* ==================== SFOGLIA ==================== */
  .pd-nav {
    background: var(--bg1);
    padding-top: 56px;
    padding-bottom: 56px;
  }
  .nav-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 24px;
    align-items: center;
  }
  .nav-l,
  .nav-r {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 0;
    min-height: 56px;
    justify-content: center;
  }
  .nav-r {
    text-align: right;
    align-items: flex-end;
  }
  .nav-lab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--red);
  }
  .nav-n {
    font-family: var(--brand);
    font-weight: 600;
    font-size: 17px;
    color: var(--navy);
    letter-spacing: -0.01em;
  }
  .nav-l:hover .nav-n,
  .nav-r:hover .nav-n {
    color: var(--red);
  }
  .nav-l .arr-l,
  .nav-r .arr {
    display: inline-flex;
    transition: transform 0.3s var(--ease);
  }
  .nav-l:hover .arr-l {
    transform: translateX(-4px);
  }
  .nav-r:hover .arr {
    transform: translateX(4px);
  }
  .nav-c {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
    border: 1px solid var(--bg2);
    border-radius: var(--r-sm);
    padding: 12px 20px;
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    background: #fff;
    transition: border-color 0.25s var(--ease), color 0.25s var(--ease);
  }
  .nav-c:hover {
    border-color: var(--navy);
    color: var(--navy);
  }

  /* ==================== CTA ==================== */
  .cta-band {
    background: var(--navy-deep);
    padding: 90px 0;
  }
  .cta-inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }
  .cta-inner h2 {
    font-family: var(--brand);
    font-weight: 600;
    font-size: clamp(30px, 4vw, 48px);
    margin: 16px 0;
    letter-spacing: -0.02em;
  }
  .cta-p {
    max-width: 46ch;
    color: rgba(255, 255, 255, 0.7);
  }

  /* ==================== RESPONSIVE ==================== */
  @media (max-width: 920px) {
    .dati-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 700px) {
    .pd-hero {
      min-height: auto;
    }
    .pd-hero-body {
      padding-top: 122px;
      padding-bottom: 44px;
    }
    .pd-dati {
      padding-top: 56px;
      padding-bottom: 64px;
    }
    .gal-grid {
      grid-template-columns: 1fr;
    }
    .gal-item.wide {
      grid-column: span 1;
    }
    /* Lo sfoglia diventa una colonna: affiancare tre elementi a 360px
       spezza i nomi su piu righe e non si legge piu niente. */
    .nav-grid {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .nav-r {
      text-align: left;
      align-items: flex-start;
    }
    .nav-c {
      order: 3;
      justify-content: center;
      margin-top: 12px;
    }
    .cta-band {
      padding: 64px 0;
    }
  }
</style>
