---
/**
 * /soluzioni/[slug] — schede tecniche di Tecnowing, Tegolo TT, Bacacier e
 * Doppia falda, versione italiana.
 *
 * Tecnoshed e Stegos restano pagine scritte a mano: sono già approvate e in
 * Astro una route statica vince su una dinamica, quindi convivono senza
 * conflitti.
 *
 * Markup e stili stanno nel componente condiviso con la versione inglese
 * (/en/solutions/tecnowing): src/components/pagine/SchedaSoluzione.astro.
 */
import SchedaSoluzione from '../../components/pagine/SchedaSoluzione.astro';
import { schedeTecniche } from '../../data/soluzioni-tecniche';
import { soluzioni } from '../../data/soluzioni';

export function getStaticPaths() {
  return schedeTecniche.map((scheda) => ({
    params: { slug: scheda.slug },
    props: { scheda },
  }));
}

const { scheda } = Astro.props;

const ui = {
  sistemaGenerico: 'Sistema di copertura prefabbricata',
  home: 'Home',
  soluzioni: 'Soluzioni',
  esploraSezione: 'Esplora la sezione',
  chiediAdatto: 'Chiedi se è adatto al tuo progetto',
  diCosaSiTratta: 'Di cosa si tratta',
  laSezione: 'La sezione',
  apriModello3d: 'Apri il modello 3D',
  datiTecnici: 'Dati tecnici',
  ilSistema: 'Il sistema',
  doveSiUsa: 'Dove si usa',
  destinazioni: "Le destinazioni d'uso più frequenti.",
  realizzazioni: 'Realizzazioni',
  comeSiVede: 'Come si vede finito.',
  notaGalleria:
    "Nota per la revisione: fotografie dall'archivio Moioli, prese dalla cartella della soluzione. Le didascalie sono da scrivere e i singoli edifici da identificare.",
  altreSoluzioni: 'Altre soluzioni',
  nonUnica: "Non è l'unica strada.",
  tutteLeSoluzioni: 'Tutte le soluzioni',
  passoSuccessivo: 'Il passo successivo',
  verifichiamo: (nome: string) => `Verifichiamo se ${nome} è adatto al tuo edificio.`,
  ctaTesto:
    "Destinazione d'uso, superficie e numero di piani: con questi tre dati possiamo già dirti se ha senso.",
  richiediValutazione: 'Richiedi una valutazione',
  galleriaAlt: (nome: string, i: number) =>
    `${nome}: realizzazione Prefabbricati Moioli, immagine ${i}`,
  heroAltFallback: (nome: string) => `Copertura ${nome} realizzata da Prefabbricati Moioli`,
};
---

<SchedaSoluzione scheda={scheda} lang="it" soluzioni={soluzioni} t={ui} />
