---
/**
 * /soluzioni — indice delle tipologie di copertura.
 * Solo Tecnoshed ha oggi una pagina dedicata: le altre voci non linkano
 * a pagine inesistenti, sono schede complete in sé.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SolutionCard from '../../components/SolutionCard.astro';
import Picture from '../../components/Picture.astro';
import { soluzioni } from '../../data/soluzioni';
import { rivestimenti } from '../../data/progetti';
import Icon from '../../components/Icon.astro';

/* Quattro campioni distanti fra loro nel campionario: danno l'idea della
   varietà meglio di quattro consecutivi, che spesso si somigliano. */
const anteprima = [0, 18, 37, 56].map((i) => rivestimenti[i]).filter(Boolean);

/* Due griglie separate invece di una sola con celle a doppia larghezza:
   con sette schede in tre colonne, le due in evidenza lasciavano un buco
   proprio nella prima riga. */
const inEvidenza = soluzioni.filter((s) => s.inEvidenza);
const altre = soluzioni.filter((s) => !s.inEvidenza);
---

<BaseLayout
  title="Soluzioni di copertura — Prefabbricati Moioli"
  description="Le sette tipologie di copertura prefabbricata Moioli: Tecnoshed, Stegos, Tecnowing, Tegolo TT, Bacacier, Doppia pendenza, Coverplan."
>
  <PageHero
    eyebrow="Soluzioni"
    title="Sette modi di coprire uno spazio."
    lead="La copertura non è un dettaglio di finitura: decide come entra la luce, quanto pesa la struttura e cosa potrai farci sopra domani. Qui trovi le tipologie che produciamo."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Soluzioni' }]}
  />

  <section class="block sol">
    <div class="wrap">
      <ul class="sol-grid sol-grid--due stagger">
        {inEvidenza.map((s, i) => <SolutionCard soluzione={s} indice={i + 1} grande />)}
      </ul>

      <ul class="sol-grid sol-grid--tre stagger">
        {
          altre.map((s, i) => (
            <SolutionCard soluzione={s} indice={inEvidenza.length + i + 1} />
          ))
        }
      </ul>

      {/* Le finiture non sono coperture: stanno qui perché struttura e
          facciata si scelgono insieme, ma in un gruppo dichiarato a parte. */}
      <div class="fin-h reveal">
        <div>
          <p class="eyebrow">Finiture</p>
          <h2>Poi c'è la faccia che l'edificio mostra fuori.</h2>
        </div>
      </div>

      <a href="/soluzioni/rivestimenti" class="fin-card reveal">
        <div class="fin-txt">
          <span class="fin-tag">Rivestimenti</span>
          <h3>Il campionario delle finiture di facciata.</h3>
          <p>
            Il pannello arriva finito dallo stabilimento: la superficie che si vede è
            quella che esce dal cassero. Graniglie, lavati, superfici a vista.
          </p>
          <span class="more">Vedi il campionario <i><Icon nome="freccia-dx" dim={15} /></i></span>
        </div>
        {/* Anteprima del campionario: quattro campioni veri valgono più di
            qualunque descrizione della superficie. */}
        <div class="fin-prov" aria-hidden="true">
          {
            anteprima.map((r) => (
              <Picture id={r.id} alt="" ratio="1/1" sizes="(max-width: 920px) 25vw, 12vw" />
            ))
          }
        </div>
      </a>

      <p class="ph-note sol-note">
        Nota per la revisione: i testi descrittivi delle tipologie sono redazionali e
        vanno validati dall'ufficio tecnico. L'abbinamento fotografia ↔ tipologia è da
        confermare. Nessun dato tecnico è stato inserito: tutte le voci in monospazio
        sono segnaposto.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-band on-dark">
    <div class="wrap">
      <div class="cta-inner reveal">
        <div>
          <p class="eyebrow">Non sai quale scegliere?</p>
          <h2>Partiamo da come userai l'edificio.</h2>
          <p class="cta-p">
            Raccontaci destinazione d'uso, superficie e vincoli del lotto: ti indichiamo la
            tipologia adatta e il perché.
          </p>
        </div>
        <a href="/contatti" class="btn btn-red">
          Parliamo del progetto <span class="arr"><Icon nome="freccia-dx" dim={17} /></span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .sol {
    background: var(--bg1);
  }

  .sol-grid {
    list-style: none;
    display: grid;
    gap: 22px;
  }

  /* Le due tipologie di punta su una riga a sé: dentro un'unica griglia a tre
     colonne lasciavano una cella vuota proprio in cima alla pagina. */
  .sol-grid--due {
    grid-template-columns: repeat(2, 1fr);
    margin-bottom: 22px;
  }

  .sol-grid--tre {
    grid-template-columns: repeat(3, 1fr);
  }

  .sol-note {
    margin-top: 40px;
  }

  /* --- Blocco finiture --------------------------------------------------- */
  .fin-h {
    margin-top: 72px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--bg2);
    margin-bottom: 24px;
  }
  .fin-h h2 {
    font-family: var(--brand);
    font-weight: 600;
    font-size: clamp(26px, 3.2vw, 38px);
    letter-spacing: -0.02em;
    margin-top: 14px;
    max-width: 24ch;
  }

  .fin-card {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: center;
    background: #fff;
    border: 1px solid var(--bg2);
    border-radius: var(--r-md);
    padding: 36px 38px;
    transition: box-shadow 0.4s var(--ease), border-color 0.4s,
      transform 0.4s var(--ease);
  }
  .fin-card:hover {
    box-shadow: var(--sh-card);
    border-color: #fff;
    transform: translateY(-4px);
  }

  .fin-tag {
    font-family: var(--brand);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--red);
  }
  .fin-txt h3 {
    font-family: var(--brand);
    font-weight: 600;
    font-size: clamp(20px, 2.2vw, 26px);
    letter-spacing: -0.01em;
    margin: 12px 0 12px;
    max-width: 22ch;
  }
  .fin-txt p {
    font-size: 14.5px;
    max-width: 52ch;
  }
  .fin-txt .more {
    margin-top: 20px;
  }

  .fin-prov {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }
  .fin-prov :global(.frame) {
    border-radius: var(--r-sm);
  }

  /* --- CTA condivisa ---------------------------------------------------- */
  .cta-band {
    background: var(--navy-deep);
    padding: 90px 0;
  }
  .cta-inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }
  .cta-inner h2 {
    font-family: var(--brand);
    font-weight: 600;
    font-size: clamp(30px, 4vw, 48px);
    margin: 16px 0;
    letter-spacing: -0.02em;
  }
  .cta-p {
    max-width: 46ch;
    color: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 1000px) {
    .sol-grid--tre {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 820px) {
    /* Testo sopra, campioni sotto: affiancati sotto questa soglia i campioni
       diventano troppo piccoli per dire qualcosa di una superficie. */
    .fin-card {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 28px 24px;
    }
  }

  @media (max-width: 700px) {
    .sol-grid--due,
    .sol-grid--tre {
      grid-template-columns: 1fr;
    }
    .fin-h {
      margin-top: 52px;
    }
    .cta-band {
      padding: 64px 0;
    }
  }
</style>
