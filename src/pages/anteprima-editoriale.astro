<script>
  /* Indice delle soluzioni: al passaggio del mouse cambia l'immagine nel
     pannello. È solo un arricchimento visivo — il pannello è aria-hidden e
     tutta l'informazione sta già nelle righe. */
  const idx = document.getElementById('idx');
  if (idx && matchMedia('(min-width: 901px)').matches) {
    const viste = Array.from(document.querySelectorAll<HTMLElement>('.v-i'));

    const mostra = (i: number) => {
      for (const v of viste) {
        if (Number(v.dataset.i) === i) v.setAttribute('data-on', '');
        else v.removeAttribute('data-on');
      }
    };

    for (const r of idx.querySelectorAll<HTMLElement>('.idx-r')) {
      const i = Number(r.dataset.i);
      r.addEventListener('mouseenter', () => mostra(i));
      /* Anche il focus da tastiera muove il pannello: chi naviga con Tab
         vede la stessa cosa di chi usa il mouse. */
      r.addEventListener('focus', () => mostra(i));
    }
  }
</script>
