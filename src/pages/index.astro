---
/**
 * / — home italiana.
 *
 * Markup, stili e script stanno nel componente condiviso con la home inglese
 * (/en): vedi src/components/pagine/Home.astro. Qui restano i contenuti.
 */
import Home from '../components/pagine/Home.astro';
import { azienda, numeri, timeline, metodo } from '../data/site';
import { soluzioni } from '../data/soluzioni';
import { realizzazioni, etichetta } from '../data/progetti';

/* In home vanno le tre realizzazioni con nome: sono quelle presentabili
   senza segnaposto. */
const primiProgetti = realizzazioni.filter((r) => !r.numerata).slice(0, 3);

const ui = {
  seoTitolo: 'Prefabbricati Moioli — Strutture prefabbricate in cemento armato dal 1972',
  seoDescrizione:
    'Progettiamo e realizziamo strutture industriali, commerciali e civili chiavi in mano. Coperture prefabbricate in cemento armato. Bagnatica (BG).',
  heroAlt: 'Struttura industriale prefabbricata realizzata da Prefabbricati Moioli',
  dal: 'Dal',
  heroLead:
    'Progettiamo e realizziamo strutture industriali, commerciali e civili chiavi in mano. Mezzo secolo di esperienza, tecnologia e affidabilità al servizio del tuo progetto.',
  parliamoProgetto: 'Parliamo del tuo progetto',
  vediRealizzazioni: 'Vedi le realizzazioni',
  scorri: 'Scorri',
  hannoScelto: 'Hanno scelto Prefabbricati Moioli',

  azEyebrow: "L'azienda",
  azTitolo: 'Un know-how che costruisce dal 1972.',
  azParagrafi: [
    "Prefabbricati Moioli nasce alla fine del <strong>1972</strong> dalla volontà e dalle esperienze combinate dei fratelli Moioli con alcuni progettisti. Fin dall'inizio un'azienda ad alto profilo tecnologico, capace di realizzare progetti unici e innovativi.",
    'In un settore che richiede <strong>qualità, competitività e sicurezza</strong>, offriamo la consulenza più completa sul progetto, unita a un supporto di tecnologia globale e a un continuo investimento in formazione e aggiornamento dello staff tecnico.',
    "Dall'ideazione al coordinamento di fornitori e maestranze, fino alla consegna: il nostro è un <strong>supporto a 360°</strong> in ogni fase del lavoro.",
  ],
  conosciAzienda: "Conosci l'azienda",
  nostroMetodo: 'Il nostro metodo',
  stabilimentoAlt:
    'Reparto di produzione degli elementi prefabbricati nello stabilimento di Bagnatica',
  anniDiStoria: 'ANNI DI STORIA',

  solEyebrow: 'Soluzioni',
  solTitolo: 'Sette modi di coprire uno spazio.',
  solIntro:
    "Sistemi di copertura prefabbricati in cemento armato. La scelta cambia in base a come l'edificio verrà usato, non solo a quanto deve essere grande.",
  scopriSoluzione: 'Scopri la soluzione',
  vediTutteSoluzioni: 'Vedi tutte le soluzioni',
  tutteLeSoluzioni: 'Tutte le soluzioni',

  mtEyebrow: 'Progetti chiavi in mano',
  mtTitolo: 'Tu desideri. Moioli realizza.',
  mtIntro:
    'Dalla progettazione alla consegna, ti affianchiamo in ogni fase con professionisti e artigiani selezionati. La nostra proposta chiavi in mano garantisce:',
  mtBanner: 'Un solo interlocutore, <b>zero pensieri</b>: dal progetto alla consegna.',
  richiediConsulenza: 'Richiedi una consulenza',

  pgEyebrow: 'Realizzazioni',
  pgTitolo: 'Oltre 700.000 mq costruiti.',
  pgIntro:
    'Una selezione dei progetti realizzati per i principali gruppi industriali e logistici del Nord Italia.',
  catRealizzazione: 'Realizzazione',
  fotografie: (n: number) => `${n} fotografie`,
  progettoAlt: (nome: string) => `${nome} — struttura prefabbricata realizzata da Moioli`,
  pgFoot: 'Più di 100 aziende ci hanno affidato i loro stabilimenti.',
  tuttiProgetti: 'Tutti i progetti',

  ctaEyebrow: 'Contatti',
  ctaTitolo: 'Parliamo del tuo progetto.',
  ctaTesto:
    'Raccontaci cosa devi costruire: ti rispondiamo con una proposta tecnica, non con un preventivo generico.',
  richiediPreventivo: 'Richiedi un preventivo',
};
---

<Home
  lang="it"
  payoff={azienda.payoff}
  numeri={numeri}
  timeline={timeline}
  metodo={metodo}
  soluzioni={soluzioni}
  progetti={primiProgetti}
  etichetta={etichetta}
  t={ui}
/>
