---
/**
 * Home.
 * Le sezioni non sono più contenuto terminale: sono ingressi verso le pagine
 * interne. Azienda e metodo restano invece contenuto di home, perché non
 * hanno una route dedicata nello scope.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Picture from '../components/Picture.astro';
import { azienda, clienti, numeri, timeline, metodo } from '../data/site';
import { soluzioni } from '../data/soluzioni';
import { progetti } from '../data/progetti';
import Icon from '../components/Icon.astro';

const inEvidenza = soluzioni.filter((s) => s.inEvidenza);
const altre = soluzioni.filter((s) => !s.inEvidenza);
const primiProgetti = progetti.slice(0, 3);
---

<BaseLayout
  title="Prefabbricati Moioli — Strutture prefabbricate in cemento armato dal 1972"
  description="Progettiamo e realizziamo strutture industriali, commerciali e civili chiavi in mano. Coperture prefabbricate in cemento armato. Bagnatica (BG)."
  preloader={true}
  preloadImage="hero-home"
>
  <!-- ==================== HERO ==================== -->
  <section class="hero" id="top">
    <div class="hero-photo" id="heroPhoto">
      <img
        src="/img/hero-home-1800.webp"
        srcset="/img/hero-home-480.webp 480w, /img/hero-home-768.webp 768w, /img/hero-home-1200.webp 1200w, /img/hero-home-1800.webp 1800w"
        sizes="100vw"
        alt="Struttura industriale prefabbricata realizzata da Prefabbricati Moioli"
        fetchpriority="high"
        decoding="sync"
      />
    </div>
    <div class="hero-grad"></div>
    <div class="hero-grid" aria-hidden="true"></div>

    <div class="since" aria-hidden="true">
      <div class="yr">{azienda.fondazione}</div>
      <div class="lb">Dal — {azienda.indirizzo.citta} ({azienda.indirizzo.provincia})</div>
    </div>

    <div class="wrap">
      <p class="eyebrow">Prefabbricati Moioli</p>
      {/* Il payoff arriva dai dati, non dal markup: è l'unico punto del sito
          in cui compare. */}
      <h1>
        <span class="ln"><span>{azienda.payoff.riga1}</span></span>
        <span class="ln"><span><em>{azienda.payoff.riga2}</em></span></span>
      </h1>
      <p class="lead">
        Progettiamo e realizziamo strutture industriali, commerciali e civili chiavi in
        mano. Mezzo secolo di esperienza, tecnologia e affidabilità al servizio del tuo
        progetto.
      </p>

      <div class="hero-cta">
        <a href="/contatti" class="btn btn-red">
          Parliamo del tuo progetto <span class="arr"><Icon nome="freccia-dx" dim={17} /></span>
        </a>
        <a href="/progetti" class="btn btn-light">Vedi le realizzazioni</a>
      </div>

      <div class="hero-stats">
        {
          numeri.map((n) => (
            <div>
              <div class="n">
                {'prefisso' in n && n.prefisso && <b>{n.prefisso}</b>}
                {'statico' in n && n.statico ? (
                  <b>{n.statico}</b>
                ) : (
                  <span data-count={n.valore}>0</span>
                )}
                {'suffisso' in n && n.suffisso}
              </div>
              <div class="l">{n.label}</div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="scroll-cue" aria-hidden="true">Scorri<i></i></div>
  </section>

  <!-- ==================== CLIENTI ==================== -->
  <div class="clients">
    <p class="tag">Hanno scelto Prefabbricati Moioli</p>
    <div class="marquee-mask">
      <div class="marquee">
        {[...clienti, ...clienti].map((c) => <span>{c}</span>)}
      </div>
    </div>
  </div>

  <!-- ==================== AZIENDA ==================== -->
  <section class="block azienda" id="azienda">
    <div class="sec-num" aria-hidden="true">01</div>
    <div class="wrap">
      <div class="az-grid">
        <div class="az-text reveal">
          <p class="eyebrow">L'azienda</p>
          <h2>Un know-how che costruisce dal 1972.</h2>
          <p>
            Prefabbricati Moioli nasce alla fine del <strong>1972</strong> dalla volontà e
            dalle esperienze combinate dei fratelli Moioli con alcuni progettisti. Fin
            dall'inizio un'azienda ad alto profilo tecnologico, capace di realizzare
            progetti unici e innovativi.
          </p>
          <p>
            In un settore che richiede <strong>qualità, competitività e sicurezza</strong>,
            offriamo la consulenza più completa sul progetto, unita a un supporto di
            tecnologia globale e a un continuo investimento in formazione e aggiornamento
            dello staff tecnico.
          </p>
          <p>
            Dall'ideazione al coordinamento di fornitori e maestranze, fino alla consegna:
            il nostro è un <strong>supporto a 360°</strong> in ogni fase del lavoro.
          </p>
          {/* Da quando esiste /azienda questa sezione è un ingresso, non più
              contenuto terminale. */}
          <div class="az-cta">
            <a href="/azienda" class="btn btn-navy az-btn">
              Conosci l'azienda <span class="arr"><Icon nome="freccia-dx" dim={17} /></span>
            </a>
            <a href="#metodo" class="btn btn-ghost az-btn">Il nostro metodo</a>
          </div>
        </div>

        <div class="az-img img-reveal">
          <Picture
            id="stabilimento"
            alt="Reparto di produzione degli elementi prefabbricati nello stabilimento di Bagnatica"
            ratio="4/3.4"
            sizes="(max-width: 920px) 100vw, 46vw"
          />
          <div class="badge">
            50+<small>ANNI DI STORIA</small>
          </div>
        </div>
      </div>

      <div class="timeline">
        <div class="rail" aria-hidden="true"><i></i></div>
        <ol class="tl-row">
          {
            timeline.map((t) => (
              <li class="tl-item">
                <div class="yr">{t.anno}</div>
                <p>{t.testo}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ==================== SOLUZIONI ==================== -->
  <section class="block soluzioni">
    <div class="sec-num" aria-hidden="true">02</div>
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">Soluzioni</p>
        <h2>Sette modi di coprire uno spazio.</h2>
        <p>
          Sistemi di copertura prefabbricati in cemento armato. La scelta cambia in base a
          come l'edificio verrà usato, non solo a quanto deve essere grande.
        </p>
      </div>

      <!-- Le due tipologie di punta ricevono un formato più ampio -->
      <div class="sol-hero stagger">
        {
          inEvidenza.map((s) => (
            <a
              href={s.href ?? '/soluzioni'}
              class="sol-big"
              aria-label={`${s.nome} — ${s.claim}`}
            >
              <div class="sol-big-img">
                {s.img && (
                  <Picture
                    id={s.img}
                    alt={s.alt}
                    ratio="16/10"
                    sizes="(max-width: 920px) 100vw, 46vw"
                  />
                )}
              </div>
              <div class="sol-big-body">
                <span class="sol-tag">{s.nome}</span>
                <h3>{s.claim}</h3>
                <p>{s.intro}</p>
                <span class="more">
                  {s.href ? 'Scopri la soluzione' : 'Vedi tutte le soluzioni'} <i><Icon nome="freccia-dx" dim={15} /></i>
                </span>
              </div>
            </a>
          ))
        }
      </div>

      <ul class="sol-list stagger">
        {
          altre.map((s) => (
            <li>
              <a href="/soluzioni">
                <span class="sl-name">{s.nome}</span>
                <span class="sl-claim">{s.claim}</span>
                <span class="sl-arr"><Icon nome="freccia-dx" dim={18} /></span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="sec-foot reveal">
        <a href="/soluzioni" class="btn btn-ghost">
          Tutte le soluzioni <span class="arr"><Icon nome="freccia-dx" dim={17} /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== METODO ==================== -->
  <section class="block metodo on-dark" id="metodo">
    <div class="sec-num" aria-hidden="true">03</div>
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">Progetti chiavi in mano</p>
        <h2>Tu desideri. Moioli realizza.</h2>
        <p>
          Dalla progettazione alla consegna, ti affianchiamo in ogni fase con professionisti
          e artigiani selezionati. La nostra proposta chiavi in mano garantisce:
        </p>
      </div>

      <div class="mt-grid stagger">
        {
          metodo.map((m) => (
            <div>
              <div class="num">{m.num}</div>
              <h3>{m.titolo}</h3>
              <p>{m.testo}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-banner reveal">
        <p class="t">Un solo interlocutore, <b>zero pensieri</b>: dal progetto alla consegna.</p>
        <a href="/contatti" class="btn btn-red">
          Richiedi una consulenza <span class="arr"><Icon nome="freccia-dx" dim={17} /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== PROGETTI ==================== -->
  <section class="block progetti">
    <div class="sec-num" aria-hidden="true">04</div>
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">Realizzazioni</p>
        <h2>Oltre 700.000 mq costruiti.</h2>
        <p>
          Una selezione dei progetti realizzati per i principali gruppi industriali e
          logistici del Nord Italia.
        </p>
      </div>

      <div class="work-grid stagger">
        {
          primiProgetti.map((p) => (
            <article class="work-card">
              <Picture
                id={p.img}
                alt={p.alt}
                ratio="4/3.5"
                sizes="(max-width: 600px) 100vw, (max-width: 920px) 50vw, 30vw"
                class="wc-img"
              />
              <div class="tint" aria-hidden="true" />
              <div class="info">
                <p class="cat">{p.settore}</p>
                <h3>{p.cliente}</h3>
                <p class="mq">{p.superficie}</p>
                <p class="loc">{p.localita}</p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="work-foot reveal">
        <p>Più di 100 aziende ci hanno affidato i loro stabilimenti.</p>
        <a href="/progetti" class="btn btn-ghost">
          Tutti i progetti <span class="arr"><Icon nome="freccia-dx" dim={17} /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== CTA ==================== -->
  <section class="cta-band on-dark">
    <div class="wrap">
      <div class="cta-inner reveal">
        <div>
          <p class="eyebrow">Contatti</p>
          <h2>Parliamo del tuo progetto.</h2>
          <p class="cta-p">
            Raccontaci cosa devi costruire: ti rispondiamo con una proposta tecnica, non con
            un preventivo generico.
          </p>
        </div>
        <div class="cta-side">
          <a href="/contatti" class="btn btn-red">
            Richiedi un preventivo <span class="arr"><Icon nome="freccia-dx" dim={17} /></span>
          </a>
          <a href={`tel:${azienda.telefonoHref}`} class="cta-tel">{azienda.telefono}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ==================== HERO ==================== */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: #fff;
    background: var(--navy);
  }

  .hero-photo {
    position: absolute;
    inset: -6%;
    will-change: transform;
    animation: slowzoom 16s ease-out forwards;
  }
  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }
  @keyframes slowzoom {
    from {
      transform: scale(1.12);
    }
    to {
      transform: scale(1.03);
    }
  }

  .hero-grad {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(29, 42, 68, 0.5) 0%,
      rgba(29, 42, 68, 0.18) 40%,
      rgba(22, 32, 58, 0.86) 86%,
      var(--navy-deep) 100%
    );
  }
  .hero-grad::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(22, 32, 58, 0.55), transparent 58%);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.05) 0 1px,
      transparent 1px calc(100% / 6)
    );
    mask-image: linear-gradient(180deg, transparent, #000 30%, #000 75%, transparent);
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 30%, #000 75%, transparent);
  }

  .hero .wrap {
    position: relative;
    z-index: 3;
    padding-bottom: 54px;
    padding-top: 150px;
    width: 100%;
  }

  .hero .eyebrow {
    color: #fff;
    opacity: 0.9;
  }

  .hero h1 {
    font-family: var(--brand);
    font-weight: 600;
    font-size: clamp(42px, 6.6vw, 94px);
    margin: 20px 0 24px;
    max-width: 15ch;
    letter-spacing: -0.02em;
    line-height: 1.02;
    color: #fff;
  }
  .hero h1 .ln {
    display: block;
    overflow: hidden;
  }
  .hero h1 .ln span {
    display: inline-block;
    transform: translateY(112%);
    transition: transform 1s var(--ease);
  }
  .hero.go h1 .ln:nth-child(2) span {
    transition-delay: 0.12s;
  }
  .hero.go h1 .ln span {
    transform: translateY(0);
  }
  .hero h1 em {
    font-style: normal;
    position: relative;
    display: inline-block;
  }
  .hero h1 em::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.06em;
    height: 0.1em;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.9s var(--ease) 0.75s;
  }
  .hero.go h1 em::after {
    transform: scaleX(1);
  }

  .hero .lead {
    max-width: 54ch;
    color: rgba(255, 255, 255, 0.85);
    opacity: 0;
    transform: translateY(20px);
    transition: 0.9s var(--ease) 0.4s;
  }
  .hero.go .lead {
    opacity: 1;
    transform: none;
  }

  .hero-cta {
    display: flex;
    gap: 14px;
    margin-top: 34px;
    flex-wrap: wrap;
    opacity: 0;
    transform: translateY(20px);
    transition: 0.9s var(--ease) 0.55s;
  }
  .hero.go .hero-cta {
    opacity: 1;
    transform: none;
  }

  .since {
    position: absolute;
    top: 150px;
    right: var(--pad);
    text-align: right;
    z-index: 3;
    opacity: 0;
    transform: translateY(-14px);
    transition: 1s var(--ease) 0.9s;
  }
  .hero.go .since {
    opacity: 1;
    transform: none;
  }
  .since .yr {
    font-family: var(--brand);
    font-weight: 700;
    font-size: clamp(38px, 4.6vw, 64px);
    color: rgba(255, 255, 255, 0.18);
    line-height: 1;
  }
  .since .lb {
    font-size: 11.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
  }

  .hero-stats {
    position: relative;
    z-index: 3;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    margin-top: 50px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    opacity: 0;
    transition: 1s var(--ease) 0.8s;
  }
  .hero.go .hero-stats {
    opacity: 1;
  }
  .hero-stats > div {
    padding: 24px 4px 4px;
    position: relative;
  }
  .hero-stats > div::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--red);
    transition: width 1.2s var(--ease) 1s;
  }
  .hero.go .hero-stats > div::before {
    width: 56px;
  }
  .hero-stats .n {
    font-family: var(--brand);
    font-weight: 700;
    font-size: clamp(26px, 3.2vw, 42px);
    color: #fff;
    line-height: 1;
  }
  .hero-stats .n b {
    /* --red su fondo navy dà 2.36:1: qui serve il rosso pensato per i fondi
       scuri, che è esattamente il motivo per cui --red-soft esiste. */
    color: var(--red-soft);
    font-weight: 700;
  }
  .hero-stats .l {
    font-size: 12.5px;
    color: rgba(255, 255, 255, 0.62);
    margin-top: 6px;
  }

  .scroll-cue {
    position: absolute;
    bottom: 26px;
    right: var(--pad);
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: rgba(255, 255, 255, 0.6);
    font-size: 10.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    opacity: 0;
    transition: 1s var(--ease) 1.3s;
  }
  .hero.go .scroll-cue {
    opacity: 1;
  }
  .scroll-cue i {
    width: 1px;
    height: 54px;
    background: rgba(255, 255, 255, 0.25);
    position: relative;
    overflow: hidden;
  }
  .scroll-cue i::after {
    content: '';
    position: absolute;
    left: 0;
    top: -100%;
    width: 100%;
    height: 100%;
    background: var(--red);
    animation: cue 2.1s var(--ease-io) infinite;
  }
  @keyframes cue {
    0% {
      top: -100%;
    }
    55% {
      top: 0;
    }
    100% {
      top: 100%;
    }
  }

  /* ==================== CLIENTI ==================== */
  .clients {
    background: var(--navy-deep);
    padding: 30px 0;
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .clients .tag {
    text-align: center;
    font-size: 11.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 20px;
  }
  .marquee-mask {
    position: relative;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee {
    display: flex;
    gap: 64px;
    width: max-content;
    animation: scroll 38s linear infinite;
  }
  .marquee-mask:hover .marquee {
    animation-play-state: paused;
  }
  .marquee span {
    font-family: var(--brand);
    font-weight: 500;
    font-size: 21px;
    /* 0.4 dava 3.72:1 su --navy-deep, sotto la soglia per un testo di 21px */
    color: rgba(255, 255, 255, 0.58);
    white-space: nowrap;
    transition: color 0.3s;
    display: flex;
    align-items: center;
    gap: 64px;
  }
  .marquee span::after {
    content: '';
    width: 5px;
    height: 5px;
    background: var(--red);
    border-radius: 50%;
    opacity: 0.6;
  }
  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }

  /* ==================== AZIENDA ==================== */
  .azienda {
    background: var(--white);
  }
  .az-grid {
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    gap: 70px;
    align-items: center;
  }
  .az-text p {
    margin-bottom: 16px;
    font-size: 16px;
  }
  .az-text strong {
    color: var(--navy);
    font-weight: 600;
  }
  .az-text h2 {
    font-family: var(--brand);
    font-weight: 600;
    font-size: clamp(32px, 4.4vw, 58px);
    margin: 16px 0 20px;
    letter-spacing: -0.02em;
  }
  .az-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 24px;
  }
  .az-btn {
    margin-top: 0;
  }

  .az-img {
    position: relative;
  }
  .az-img::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--r-md);
    background: linear-gradient(165deg, rgba(29, 42, 68, 0.06), rgba(29, 42, 68, 0.42));
    pointer-events: none;
  }
  .az-img .badge {
    position: absolute;
    bottom: 22px;
    left: 22px;
    z-index: 3;
    background: var(--red);
    color: #fff;
    font-family: var(--brand);
    font-weight: 700;
    font-size: 30px;
    padding: 14px 20px;
    line-height: 1;
    border-radius: var(--r-sm);
    box-shadow: 0 18px 40px -16px rgba(0, 0, 0, 0.5);
  }
  .az-img .badge small {
    display: block;
    font-family: var(--ui-font);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.14em;
    opacity: 0.9;
    margin-top: 6px;
  }

  .timeline {
    margin-top: 84px;
    position: relative;
  }
  .timeline .rail {
    position: absolute;
    top: 7px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--bg2);
  }
  .timeline .rail i {
    display: block;
    height: 100%;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1.8s var(--ease-io) 0.2s;
  }
  .timeline.in .rail i {
    transform: scaleX(1);
  }
  .tl-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
    list-style: none;
  }
  .tl-item {
    position: relative;
    padding-top: 30px;
  }
  .tl-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--white);
    border: 3px solid var(--red);
    transform: scale(0);
    transition: transform 0.5s var(--ease);
  }
  .timeline.in .tl-item::before {
    transform: scale(1);
  }
  .timeline.in .tl-item:nth-child(2)::before {
    transition-delay: 0.35s;
  }
