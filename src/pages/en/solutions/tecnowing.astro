---
/**
 * /en/solutions/tecnowing — la scheda Tecnowing in inglese, con il modello
 * tridimensionale navigabile al posto del disegno in sezione.
 *
 * È una copia di src/pages/soluzioni/tecnowing.astro: stesso markup, stesso
 * foglio di stile, testi dall'inglese (src/i18n/en/tecnowing.ts). Una
 * correzione di impaginazione va fatta in tutti e due i file — le ragioni
 * delle scelte (iframe lazy, banda a tutta larghezza, velo al tocco) sono
 * scritte lì.
 *
 * Il visualizzatore è lo stesso della pagina italiana e non è tradotto: la
 * sua interfaccia resta in italiano, e il testo della sezione lo dice.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Picture from '../../../components/Picture.astro';
import Icon from '../../../components/Icon.astro';
import { tecnowing as scheda, ui as t } from '../../../i18n/en/tecnowing';
import { soluzioni } from '../../../i18n/en/contenuti';
import { ui } from '../../../i18n';
import foto from '../../../data/soluzioni-foto.json';
import images from '../../../data/images.json';

const MODELLO = '/soluzioni/tecnowing/configuratore-3d-fasce';

const galleria = (foto as Record<string, { cover: string; galleria: { id: string }[] }>)[scheda.slug];
const cover = galleria?.cover;
const coverMeta = cover ? (images as Record<string, { widths: number[] }>)[cover] : undefined;
const coverSrcset = coverMeta
  ? coverMeta.widths.map((w) => `/img/${cover}-${w}.webp ${w}w`).join(', ')
  : '';
const coverSrc = coverMeta ? `/img/${cover}-${coverMeta.widths.at(-1)}.webp` : '';

const scheda0 = soluzioni.find((s) => s.slug === scheda.slug);
const altre = soluzioni.filter((s) => s.slug !== scheda.slug).slice(0, 3);

const BASE = 'https://www.prefabbricatimoioli.it';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.home, item: `${BASE}/en` },
    { '@type': 'ListItem', position: 2, name: t.soluzioni, item: `${BASE}/en/solutions` },
    { '@type': 'ListItem', position: 3, name: scheda.nome },
  ],
};
---

<BaseLayout
  title={`${scheda.nome} — ${scheda.alias ?? t.sistemaGenerico} | Prefabbricati Moioli`}
  description={scheda.meta}
  preloadImage={cover}
  jsonLd={jsonLd}
  lang="en"
>
  <!-- ==================== 1. APERTURA ==================== -->
  <section class="sg-hero on-dark">
    {
      coverSrc && (
        <div class="sg-hero-img">
          <img
            src={coverSrc}
            srcset={coverSrcset}
            sizes="100vw"
            alt={scheda0?.alt ?? t.heroAltFallback(scheda.nome)}
            fetchpriority="high"
            decoding="sync"
          />
        </div>
      )
    }
    <div class="sg-hero-grad" aria-hidden="true"></div>

    <div class="wrap sg-hero-body">
      <Breadcrumb
        items={[
          { label: t.home, href: '/en' },
          { label: t.soluzioni, href: '/en/solutions' },
          { label: scheda.nome },
        ]}
      />
      <p class="eyebrow sg-eyebrow">{scheda.eyebrow}</p>
      <h1>{scheda.nome}</h1>
      {scheda.alias && <p class="sg-alias">{scheda.alias}</p>}
      <p class="sg-claim">{scheda.claim}</p>
      <p class="lead sg-lead">{scheda.lead}</p>

      <div class="sg-hero-cta">
        <a href="#sezione" class="btn btn-red">
          Explore the 3D model
          <span class="arr"><Icon nome="freccia-giu" dim={17} /></span>
        </a>
        <a href="/en/contact" class="btn btn-light">{t.chiediAdatto}</a>
      </div>
    </div>
  </section>

  <!-- ==================== 2. DI COSA SI TRATTA ==================== -->
  <section class="block sg-id">
    <div class="sec-num" aria-hidden="true">01</div>
    <div class="wrap">
      <div class="sg-id-grid">
        <div class="reveal">
          <p class="eyebrow">{t.diCosaSiTratta}</p>
          <h2>{scheda.identita.titolo}</h2>
        </div>
        <div class="sg-id-text reveal">
          {scheda.identita.paragrafi.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <ul class="sg-car stagger">
        {
          scheda.caratteristiche.map((c) => (
            <li>
              <h3>{c.titolo}</h3>
              <p>{c.testo}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ==================== 3. IL MODELLO 3D — il blocco centrale ========= -->
  {/* Prende il posto che nella scheda corrente è del disegno in sezione con
      i sei punti: il visualizzatore ha già il suo elenco di componenti
      selezionabili, tenere anche l'altro significherebbe due interfacce che
      dicono la stessa cosa. */}
  <section class="sg-sez on-dark" id="sezione">
    <div class="sec-num" aria-hidden="true">02</div>
    <div class="wrap">
      <div class="sg-sez-head reveal">
        <p class="eyebrow">The model</p>
        <h2>{scheda.sezione.titolo}</h2>
        <p class="sg-sez-intro">
          The roof assembled, not drawn. Drag to walk around it, select a
          component to isolate it, change the infill and the configuration:
          the model rebuilds itself. The model interface is in Italian.
        </p>
      </div>
    </div>

    <div class="sg-viewer reveal" id="sgViewer">
      {/* Solo al tocco: il modello occupa quasi tutto lo schermo e prende per
          sé ogni trascinamento, quindi la pagina smetterebbe di scorrere. Il
          velo lascia passare lo scorrimento finché non lo si tocca. */}
      <button type="button" class="sg-velo" id="sgVelo">
        <span class="sg-velo-t">Tap to explore the model</span>
        <span class="sg-velo-s">Then drag to rotate it</span>
      </button>
      <iframe
        src={MODELLO}
        title={`Three-dimensional model of the ${scheda.nome} roof`}
        loading="lazy"
        allow="fullscreen"
        allowfullscreen
      ></iframe>
    </div>

    <div class="wrap">
      {/* Senza JavaScript l'iframe resta una cornice vuota: il rimando in
          chiaro è l'unica cosa che rimane utile. */}
      <noscript>
        <p class="sg-viewer-ns">
          The three-dimensional model requires JavaScript.
          <a href={MODELLO}>Open it in a separate tab</a>.
        </p>
      </noscript>

      <div class="sg-viewer-foot">
        <p>
          The model is a reading aid: the dimensions that count are those in
          the table below.
        </p>
        <a href={MODELLO} class="btn btn-light" target="_blank" rel="noopener">
          Open it in a separate tab
          <span class="arr"><Icon nome="freccia-dx" dim={17} /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== 4. DATI TECNICI ==================== -->
  <section class="block sg-dati-s">
    <div class="sec-num" aria-hidden="true">03</div>
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">{t.datiTecnici}</p>
        <h2>{scheda.dati.titolo}</h2>
      </div>

      <dl class:list={['sg-dati', 'stagger', `n-${scheda.dati.voci.length}`]}>
        {
          scheda.dati.voci.map((v) => (
            <div>
              <dt>{v.label}</dt>
              <dd>
                <span class="v">{v.valore}</span>
                {v.unita && <span class="u">{v.unita}</span>}
                {v.nota && <span class="nt">{v.nota}</span>}
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="sg-dati-n">{scheda.dati.nota}</p>
    </div>
  </section>

  <!-- ==================== 5. IL SISTEMA ==================== -->
  <section class="block sg-sis on-dark">
    <div class="sec-num" aria-hidden="true">04</div>
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">{t.ilSistema}</p>
        <h2>{scheda.sistema.titolo}</h2>
        <p>{scheda.sistema.intro}</p>
      </div>

      <ul class="sg-comp stagger">
        {
          scheda.sistema.componenti.map((c, i) => (
            <li>
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{c.nome}</h3>
                <p>{c.testo}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ==================== 6. APPLICAZIONI ==================== -->
  <section class="block sg-app">
    <div class="sec-num" aria-hidden="true">05</div>
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">{t.doveSiUsa}</p>
        <h2>{t.destinazioni}</h2>
      </div>

      <ul class="adv-grid stagger">
        {
          scheda.applicazioni.map((v) => (
            <li>
              <span class="adv-n">{v.num}</span>
              <h3>{v.titolo}</h3>
              <p>{v.testo}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ==================== 7. GALLERY ==================== -->
  {
    galleria && galleria.galleria.length > 0 && (
      <section class="block sg-gal on-dark">
        <div class="sec-num" aria-hidden="true">06</div>
        <div class="wrap">
          <div class="sec-head reveal">
            <p class="eyebrow">{t.realizzazioni}</p>
            <h2>{t.comeSiVede}</h2>
          </div>

          <div class="gal-grid stagger">
            {galleria.galleria.map((img, i) => (
              <figure class:list={['gal-item', { wide: i === 0 }]}>
                <Picture
                  id={img.id}
                  alt={t.galleriaAlt(scheda.nome, i + 1)}
                  ratio={i === 0 ? '21/9' : '4/3'}
                  sizes="(max-width: 700px) 100vw, 50vw"
                />
              </figure>
            ))}
          </div>

          <p class="ph-note gal-note">{t.notaGalleria}</p>
        </div>
      </section>
    )
  }

  <!-- ==================== 8. ALTRE SOLUZIONI ==================== -->
  <section class="block sg-other">
    <div class="wrap">
      <div class="other-head reveal">
        <div>
          <p class="eyebrow">{t.altreSoluzioni}</p>
          <h2>{t.nonUnica}</h2>
        </div>
        <a href="/en/solutions" class="btn btn-ghost">
          {t.tutteLeSoluzioni} <span class="arr"><Icon nome="freccia-dx" dim={17} /></span>
        </a>
      </div>

      <ul class="other-grid stagger">
        {
          altre.map((s) => (
            <li>
              <a href={s.href ?? '/en/solutions'}>
                {s.img ? (
                  <Picture id={s.img} alt={s.alt} ratio="4/3" sizes="(max-width: 700px) 100vw, 33vw" />
                ) : (
                  <div class="other-noimg">
                    <span class="spec">{ui.en.fotoDaServizio}</span>
                  </div>
                )}
                <h3>{s.nome}</h3>
                <p>{s.claim}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ==================== 9. CTA ==================== -->
  <section class="cta-band on-dark">
    <div class="wrap">
      <div class="cta-inner reveal">
        <div>
          <p class="eyebrow">{t.passoSuccessivo}</p>
          <h2>{t.verifichiamo(scheda.nome)}</h2>
          <p class="cta-p">{t.ctaTesto}</p>
        </div>
        <a href="/en/contact" class="btn btn-red">
          {t.richiediValutazione} <span class="arr"><Icon nome="freccia-dx" dim={17} /></span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ==================== 1. APERTURA ==================== */
  .sg-hero {
    position: relative;
    min-height: 88svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--navy);
    color: #fff;
  }
  .sg-hero-img {
    position: absolute;
    inset: 0;
  }
  .sg-hero-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
  }
  .sg-hero-grad {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(22, 32, 58, 0.76) 0%,
      rgba(29, 42, 68, 0.42) 34%,
      rgba(22, 32, 58, 0.9) 82%,
      var(--navy) 100%
    );
  }
  .sg-hero-body {
    position: relative;
    z-index: 2;
    padding-top: 150px;
    padding-bottom: 64px;
    width: 100%;
  }
  .sg-eyebrow {
    margin-top: 24px;
    color: var(--red-soft);
  }
  .sg-hero h1 {
    font-family: var(--brand);
    font-weight: 600;
    font-size: clamp(48px, 8vw, 104px);
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 16px 0 10px;
    color: #fff;
  }
  /* Il nome descrittivo sta sotto il nome commerciale: è la parola con cui la
     soluzione viene chiesta al telefono, non può sparire. */
  .sg-alias {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
    margin-bottom: 14px;
  }
  .sg-claim {
    font-family: var(--brand);
    font-weight: 500;
    font-size: clamp(19px, 2.4vw, 28px);
    color: #fff;
    line-height: 1.25;
    max-width: 24ch;
  }
  .sg-lead {
    margin-top: 20px;
    color: rgba(255, 255, 255, 0.78);
    max-width: 58ch;
  }
  .sg-hero-cta {
    display: flex;
    gap: 14px;
    margin-top: 34px;
    flex-wrap: wrap;
  }

  /* ==================== 2. DI COSA SI TRATTA ==================== */
  .sg-id {
    background: var(--white);
    padding-top: 96px;
    padding-bottom: 104px;
  }
  .sg-id-grid {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    gap: 52px;
    align-items: start;
    margin-bottom: 52px;
  }
  .sg-id-grid h2 {
    font-family: var(--brand);
    font-weight: 600;
    font-size: clamp(30px, 4vw, 50px);
    margin-top: 16px;
    letter-spacing: -0.02em;
  }
  .sg-id-text p {
    font-size: 17px;
    margin-bottom: 18px;
    max-width: 62ch;
  }
  .sg-id-text p:last-child {
    margin-bottom: 0;
  }

  .sg-car {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--bg2);
    border: 1px solid var(--bg2);
    border-radius: var(--r-md);
    overflow: hidden;
  }
  .sg-car li {
    background: #fff;
    padding: 28px 24px 30px;
  }
  .sg-car h3 {
    font-family: var(--brand);
    font-weight: 600;
    font-size: 17px;
    line-height: 1.25;
    margin-bottom: 10px;
  }
  .sg-car p {
    font-size: 14px;
    color: var(--text-2);
  }

  /* ==================== 3. SEZIONE INTERATTIVA ==================== */
  .sg-sez {
    background: var(--navy-deep);
    padding: 152px 0;
    position: relative;
  }
  .sg-sez-head {
    max-width: 680px;
    margin-bottom: 56px;
  }
  .sg-sez-head h2 {
    font-family: var(--brand);
    font-weight: 600;
    font-size: clamp(34px, 4.8vw, 62px);
    margin-top: 18px;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }

  .sg-sez-intro {
    margin-top: 20px;
    color: rgba(255, 255, 255, 0.72);
    max-width: 56ch;
  }

  /* La banda del modello. Tocca i due bordi e prende l'altezza dello
     schermo: dentro c'è un'interfaccia con testata, due fasce laterali e
     piede, che rientrata e a 80vh finiva compressa. Non è però una presa
     dello schermo: la pagina resta una pagina e lo scorrimento continua.

     I 96px tolti sono la testata del sito, che è fissa: senza, il piede del
     visualizzatore resterebbe sempre sotto il bordo dello schermo. È la
     stessa misura di `scroll-padding-top`, così quando la banda si ferma
     sotto la testata ci sta esatta. */
  .sg-viewer {
    height: calc(100svh - 96px);
    min-height: 560px;
    max-height: 940px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    overflow: hidden;
    background: var(--navy);
  }
  .sg-viewer iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Velo per il tocco: con il mouse la rotellina scorre comunque la pagina,
     quindi esiste solo sui dispositivi senza puntatore fine. */
  .sg-viewer {
    position: relative;
  }
  .sg-velo {
    display: none;
  }
  @media (pointer: coarse) {
    .sg-velo {
      position: absolute;
      inset: 0;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      gap: 4px;
      padding: 0 var(--pad) 36px;
      border: 0;
      background: linear-gradient(to top, rgba(17, 25, 46, 0.82), rgba(17, 25, 46, 0) 45%);
      color: #fff;
      font-family: var(--ui-font);
      cursor: pointer;
      /* Lo scorrimento verticale passa alla pagina: il velo intercetta solo
         il tocco secco. */
      touch-action: pan-y;
    }
    .sg-velo.via {
      display: none;
    }
  }
  .sg-velo-t {
    font-family: var(--brand);
    font-weight: 600;
    font-size: 17px;
    padding: 12px 20px;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: var(--r-sm);
    background: rgba(17, 25, 46, 0.6);
  }
  .sg-velo-s {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.7);
    margin-top: 6px;
  }

  .sg-viewer-ns {
    margin-top: 18px;
    color: rgba(255, 255, 255, 0.72);
  }
  .sg-viewer-ns a {
    color: #fff;
    text-decoration: underline;
  }

  .sg-viewer-foot {
    margin-top: 32px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }
  .sg-viewer-foot p {
    max-width: 52ch;
    font-size: 14.5px;
    color: rgba(255, 255, 255, 0.66);
  }

  /* ==================== 4. DATI TECNICI ==================== */
  .sg-dati-s {
    background: var(--bg1);
  }
  /* Il numero di dati cambia da scheda a scheda: la griglia si adatta invece
     di lasciare buchi in fondo alla riga. */
  .sg-dati {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1px;
    background: var(--bg2);
    border: 1px solid var(--bg2);
    border-radius: var(--r-md);
    overflow: hidden;
  }
  .sg-dati.n-4 {
    grid-template-columns: repeat(4, 1fr);
  }
  .sg-dati.n-5 {
    grid-template-columns: repeat(5, 1fr);
  }
  .sg-dati.n-6 {
    grid-template-columns: repeat(3, 1fr);
  }
  /* Ogni cella e' un subgrid di due righe: l'etichetta sta nella prima, il
     valore nella seconda. Le righe sono quelle della griglia madre, quindi i
     valori partono alla stessa altezza in tutti i riquadri anche quando una
     nota o un valore a capo cambiano l'ingombro. Il gap di 1px della madre
     disegna i separatori: dentro la cella va azzerato, altrimenti taglierebbe
     una riga fra etichetta e valore. */
  .sg-dati > div {
    background: #fff;
    padding: 26px 22px 28px;
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 2;
    row-gap: 0;
    justify-items: center;
    text-align: center;
    min-width: 0;
  }
  .sg-dati dt {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 14px;
  }
  .sg-dati dd {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .sg-dati .v {
    font-family: var(--brand);
    font-weight: 600;
    font-size: 24px;
    color: var(--navy);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    line-height: 1.15;
    /* Le serie di altezze sono lunghe: devono poter andare a capo ovunque. */
    overflow-wrap: anywhere;
  }
  .sg-dati .u {
    font-family: var(--brand);
    font-weight: 500;
    font-size: 15px;
    color: var(--text-2);
  }
  .sg-dati .nt {
    flex-basis: 100%;
    font-size: 12.5px;
    color: var(--text-2);
    margin-top: 6px;
  }
  .sg-dati-n {
    margin-top: 20px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-2);
  }

  /* ==================== 5. IL SISTEMA ==================== */
  .sg-sis {
    background: var(--navy);
  }
  .sg-comp {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 52px;
  }
  .sg-comp li {
    display: flex;
    gap: 18px;
    padding: 24px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .sg-comp .n {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--red-soft);
    flex: none;
    padding-top: 4px;
  }
  .sg-comp h3 {
    font-family: var(--brand);
    font-weight: 600;
    font-size: 18px;
    margin-bottom: 6px;
  }
  .sg-comp p {
    font-size: 14.5px;
    color: rgba(255, 255, 255, 0.66);
  }

  /* ==================== 6. APPLICAZIONI ==================== */
  .sg-app {
    background: var(--bg1);
  }
  .adv-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }
  .adv-grid li {
