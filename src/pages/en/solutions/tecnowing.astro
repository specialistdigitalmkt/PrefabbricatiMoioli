<script>
  /* Velo del modello 3D sui dispositivi al tocco: un tocco lo toglie e passa
     il controllo al modello; quando il modello esce dallo schermo il velo
     torna, così risalendo la pagina non ci si ritrova di nuovo bloccati. */
  const viewer = document.getElementById('sgViewer');
  const velo = document.getElementById('sgVelo');

  if (viewer && velo) {
    velo.addEventListener('click', () => {
      velo.classList.add('via');
      viewer.querySelector('iframe')?.focus();
    });

    new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) velo.classList.remove('via');
    }).observe(viewer);
  }
</script>
